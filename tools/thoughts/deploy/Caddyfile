# Managed by naro-thoughts. Existing unrelated Caddy sites must be preserved separately.
narozeol.top {
    encode zstd gzip
    @thoughts path /api/* /app/*
    handle @thoughts {
        reverse_proxy 127.0.0.1:8765
    }
    handle {
        root * /var/www/naro-blog
        file_server
    }
    handle_errors {
        @notfound expression {err.status_code} == 404
        rewrite @notfound /404.html
        file_server
    }
}
